# ================================================================
#  FRONTEND (Vite) — build-time variable.
#  Local dev: leave unset (the Vite proxy forwards /api to :4000).
#  Production: set VITE_API_BASE in Vercel's Environment Variables to your
#  backend's public URL + /api. It is baked in at build time.
# ================================================================
# VITE_API_BASE=https://steve-gateway-XXXX.run.app/api   # your Cloud Run gateway URL + /api

# ================================================================
#  BACKEND — Node / Express gateway
# ================================================================
PORT=4000
# MongoDB connection. Local mongod, or a MongoDB Atlas SRV string in prod.
MONGODB_URI=mongodb://localhost:27017/study_buddy_steve
# Long random string — signs session JWTs AND the OAuth state param.
JWT_SECRET=change_me
# Comma-separated allowlist of allowed frontend origins (prod + Vercel previews).
FRONTEND_URL=http://localhost:5173
# Cross-domain deploys need SameSite=None;Secure cookies. Setting NODE_ENV to
# production enables this automatically; or force it with COOKIE_SAMESITE=none.
# NODE_ENV=production
# COOKIE_SAMESITE=none

# ---- Background push reminders (deadlines when the app is closed) ----
# Generate once:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared secret the Cloud Scheduler cron uses to call /api/cron/send-reminders.
CRON_SECRET=change_me_too

# ---- SMS reminders (optional, via Twilio) ----
# From console.twilio.com. Leave blank to disable SMS (push + calendar still work).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=            # an SMS-capable Twilio number, e.g. +15005550006

# ================================================================
#  Python AI parser service
# ================================================================
# URL the gateway calls to parse syllabi (the deployed Python service in prod).
PARSER_SERVICE_URL=http://localhost:8000
# Optional LLM "smart path" for relative dates. Set ONE. Anthropic wins if both.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ================================================================
#  Google Calendar OAuth  (see OAUTH_SETUP.md)
# ================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the backend's PUBLIC url in production, e.g.
# https://steve-gateway-XXXX.run.app/api/oauth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:4000/api/oauth/google/callback

# ================================================================
#  Microsoft / Outlook OAuth  (see OAUTH_SETUP.md)
# ================================================================
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:4000/api/oauth/outlook/callback
